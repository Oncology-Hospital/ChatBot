# Chatwoot Production Config
SECRET_KEY_BASE=

# Public Chatwoot URL, used by Chatwoot itself and as a fallback for bot auth.
FRONTEND_URL=https://adminchatbot.example.com

# Optional bot-side Chatwoot URLs.
# Local direct run: set CHATWOOT_URL=http://localhost:3000 if you want to auth against local Chatwoot.
# Docker/VPS compose: CHATWOOT_URL=http://rails:3000 is usually injected by docker-compose.yml.
# CHATWOOT_API_URL can be used when bot API calls should use a different internal URL.
# CHATWOOT_AUTH_URL can be used when admin login should auth against a different URL.
CHATWOOT_URL=
CHATWOOT_API_URL=
CHATWOOT_AUTH_URL=
TEST_CHATWOOT_EMAIL=
TEST_CHATWOOT_PASSWORD=
ENABLE_ACCOUNT_SIGNUP=true

# Postgres
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=chatwoot_production
RAILS_ENV=production

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# Misc
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
RAILS_MAX_THREADS=5

# Storage
ACTIVE_STORAGE_SERVICE=local

# SMTP
SMTP_ADDRESS=

# Chatwoot bot access
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
ENABLE_RACK_ATTACK=false

# Appointment approval queue database
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_INSTANCE=
MSSQL_DATABASE=QuanLyChatBot
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true

# Youmed API
YOUMED_BASE_URL=
YOUMED_USERNAME=
YOUMED_PASSWORD=
BOT_PUBLIC_URL=
