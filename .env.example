# Chatwoot Production Config
SECRET_KEY_BASE=

FRONTEND_URL=https://adminchatbot.example.com
ENABLE_ACCOUNT_SIGNUP=true

# Postgres
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=chatwoot_production
RAILS_ENV=production

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# Misc
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
RAILS_MAX_THREADS=5

# Storage
ACTIVE_STORAGE_SERVICE=local

# SMTP
SMTP_ADDRESS=

# Chatwoot bot access
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
ENABLE_RACK_ATTACK=false

# Appointment approval queue database
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_INSTANCE=
MSSQL_DATABASE=QuanLyChatBot
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true

# Youmed API
YOUMED_BASE_URL=
YOUMED_USERNAME=
YOUMED_PASSWORD=
BOT_PUBLIC_URL=
